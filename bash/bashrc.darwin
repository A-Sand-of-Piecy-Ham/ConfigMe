# Login shells on macOS source only .bash_profile; pull it in here so
# interactive non-login shells get the same PATH and exports.
if [ -f ~/.bash_profile ]; then
    source ~/.bash_profile
fi

### MANAGED BY RANCHER DESKTOP START (DO NOT EDIT)
export PATH="/Users/maxwagner/.rd/bin:$PATH"
### MANAGED BY RANCHER DESKTOP END (DO NOT EDIT)

# Shared, platform-agnostic config (PATH, aliases, EDITOR, ccache).
[ -f "$HOME/.config/dotfiles/common.sh" ] && . "$HOME/.config/dotfiles/common.sh"

if [ -f $(brew --prefix)/etc/bash_completion ]; then
    . $(brew --prefix)/etc/bash_completion
fi

export PATH="$(brew --prefix rustup)/bin:$PATH"
export PATH="$HOME/scripts/git-fuzzy/bin:$PATH"
