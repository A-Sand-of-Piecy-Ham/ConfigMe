# Eclipse Buildship annotation-processor classpath file — generated per Gradle
# subproject on sync when annotation processing (Lombok, QueryDSL, Spring Data)
# is in play. Contains hardcoded absolute paths into the local ~/.gradle cache.
**/.factorypath

# Harper grammar/spell-checker extension's local custom dictionary file.
.harper-dictionary.txt

# clangd compile-flags config — commonly hardcodes an absolute local
# CompilationDatabase build path, so it's machine-local, not repo-shared.
.clangd

**/.claude/settings.local.json

# macOS Finder folder-metadata file — created in every directory Finder
# touches, never meaningful to share.
.DS_Store

# Python bytecode cache — written into __pycache__/ beside any .py file that
# Python imports, so running a test or a REPL against a repo's own Python
# leaves compiled files in the working tree. Machine-specific build output.
__pycache__/
*.py[cod]
