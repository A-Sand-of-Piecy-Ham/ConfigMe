[user]
	name = Max Wanger
	email = maxwamger@gmail.com
	signingkey = ~/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	gpgsign = true
	verbose = true
[tag]
	gpgSign = true
[sequence]
	editor = nvim
[push]
	default = simple
	autoSetupRemote = true
[core]
	excludesfile = ~/.gitignore_global
	editor = nvim
	untrackedCache = true
	fsmonitor = true
	# Git for Windows enforces its own MAX_PATH limit independently of the
	# LongPathsEnabled registry setting, so the OS toggle alone is not enough.
	# Ignored on macOS and Linux, so this stays a single shared config.
	longpaths = true
[merge]
	conflictstyle = zdiff3
[color]
	ui = auto
[pull]
	rebase = true
[fetch]
	prune = true
	parallel = 0
[rerere]
	enabled = true
	autoupdate = true
[rebase]
	autoStash = true
[diff]
	algorithm = histogram
[init]
	defaultBranch = main
