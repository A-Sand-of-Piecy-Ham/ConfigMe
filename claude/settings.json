{
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Artifact"
    ]
  },
  "hooks": {
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/log-instructions-loaded"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/docs-audience-hook",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/bash-skill-hook",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__context7__.*|mcp__15fae7e2-.*|mcp__claude_ai_TickTick__.*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/mcp-skill-hook",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/context-size-hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-version-watch",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/compact-notes-hook",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "effortLevel": "medium",
  "askUserQuestionTimeout": "never",
  "theme": "auto",
  "editorMode": "vim",
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoCompactWindow": 200000,
  "env": {
    "CLAUDE_CODE_IDLE_COMPACT_MIN_TOKENS": "100000"
  },
  "cleanupPeriodDays": 365
}
