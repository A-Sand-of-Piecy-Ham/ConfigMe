#!/usr/bin/env bash
# Make a sealed copy of a frame repo for a second run of one milestone:
#
#     ab-clone <repo dir> <new dir> [base commit] [default branch] [branch...]
#
# The copy holds the default branch up to the base commit and nothing else:
# no other branch, no remote, and no object of any later commit, so a session
# working in it cannot read the first run's code through git. The base
# defaults to the tip of the default branch ("main"). Give the commit the
# first run branched from when the default branch has moved on since.
#
# Branches named after the default branch are carried into the copy as well.
# That is for comparing two reviewers (ab.md, "Two reviewers"): each gets a
# copy holding the branches under review and cannot see the other's work.
# Write "" for the base to mean the tip:  ab-clone . ../ab/r1 "" main m3-combat
#
# What this does not seal: the original repo is still on disk. Keep its
# checkout on the default branch while the second run works, and do not merge
# the first run until the second has finished.
#
# How to run the comparison and bring the result back: ab.md, beside this file.
set -eu
src="$(git -C "${1:?usage: ab-clone <repo dir> <new dir> [base commit] [default branch]}" rev-parse --show-toplevel)"
dst="${2:?usage: ab-clone <repo dir> <new dir> [base commit] [default branch]}"
main="${4:-main}"
base="$(git -C "$src" rev-parse --verify --quiet "${3:-$main}^{commit}")" \
    || { echo "not a commit in $src: ${3:-$main}" >&2; exit 2; }
extra=("${@:5}")
for b in "${extra[@]}"; do
    git -C "$src" rev-parse --verify --quiet "refs/heads/$b" >/dev/null \
        || { echo "not a branch in $src: $b" >&2; exit 2; }
done
[[ -e "$dst" ]] && { echo "already exists: $dst" >&2; exit 2; }
git -C "$src" merge-base --is-ancestor "$base" "$main" \
    || { echo "$base is not on $main; a copy can only be cut from $main's history" >&2; exit 2; }

# --no-local sends only what the branch reaches. A plain local clone links
# the whole object store, other branches' commits included.
git clone --quiet --no-local --single-branch --branch "$main" "$src" "$dst"
git -C "$dst" reset --quiet --hard "$base"
for b in "${extra[@]}"; do
    git -C "$dst" fetch --quiet --no-tags "$src" "refs/heads/$b:refs/heads/$b"
done
git -C "$dst" remote remove origin
git -C "$dst" reflog expire --expire=now --all
git -C "$dst" gc --quiet --prune=now

# Prove the seal instead of assuming it.
tip="$(git -C "$src" rev-parse "$main")"
if [[ "$tip" != "$base" ]] && git -C "$dst" cat-file -e "$tip" 2>/dev/null; then
    echo "seal failed: $dst can still read $tip" >&2; exit 1
fi
refs="$(git -C "$dst" for-each-ref --format='%(refname)' | sort)"
want="$(printf 'refs/heads/%s\n' "$main" "${extra[@]}" | sort)"
[[ "$refs" == "$want" ]] || { echo "seal failed: unexpected refs in $dst: $refs" >&2; exit 1; }

echo "sealed copy: $dst"
echo "  at $(git -C "$dst" log --oneline -1)"
if (( ${#extra[@]} )); then
    echo "  also holds: ${extra[*]}"
    echo "Start the reviewing session with $dst as its folder."
else
    echo "Start the second session with $dst as its folder and give it the same request as the first."
fi
