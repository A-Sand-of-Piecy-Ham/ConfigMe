#!/usr/bin/env bash
# Print how many tokens a Claude Code session reads before it does anything: once as
# `claude` starts it, once as `claude-lean` does. Run it from the folder you care about,
# since CLAUDE.md and AGENTS.md there are part of the count.
#
# Built-in tool definitions change between releases, so re-run this after an update
# (bin/claude-version-watch asks for it). If the two numbers have drifted together, a new
# built-in tool has probably arrived and belongs in claude/profiles/lean.json.
#
# Each run is one short call to the small model, with nothing saved.
# Reference, 2026-11-10, 2.1.295, an empty folder: plain 37.0k, lean 30.7k.
set -euo pipefail

here="$(dirname "$(readlink -f "$0")")"

size() {
    env -u CLAUDE_CODE_ENTRYPOINT "$@" -p "Reply with the single word ok." --model haiku \
        --no-session-persistence --output-format json </dev/null |
        jq -r 'if .is_error then "failed: \(.result)"
               else (.usage | .input_tokens + .cache_read_input_tokens + .cache_creation_input_tokens)
               end'
}

echo "plain: $(size claude)"
echo "lean:  $(size "$here/claude-lean")"
