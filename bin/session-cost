#!/usr/bin/env python3
"""Print what a Claude Code session cost, turn by turn, in weighted units.

    session-cost [SESSION_ID | TRANSCRIPT.jsonl]     default: $CLAUDE_CODE_SESSION_ID

The usage meter the user sees gives one percentage for a five-hour window. It does not say
which turn, call or tool spent it, and raw token counts mislead: a cached token read costs a
fiftieth of an output token. The transcript records every call's usage, so this is the
measurement to reason from when a session is said to have cost too much.

A unit is one uncached input token of the model that ran. Weights follow the API price list:
cache read 0.1, five-minute cache write 1.25, one-hour cache write 2, output 5. Units from
different models are not comparable; the script does not convert between them.

A turn starts at a message the user typed and runs to the next one. Each row gives the model
calls made, the units spent, their share by kind, the largest context any call read, and an
estimated share of the five-hour limit.
"""
import json
import os
import sys
from glob import glob
from pathlib import Path

WEIGHTS = {"in": 1.0, "read": 0.1, "w5m": 1.25, "w1h": 2.0, "out": 5.0}
# Units in one five-hour window of the user's plan (Pro), for the strongest model. An estimate
# from two readings on 2026-11-11: 1.4M units moved the meter by "30%+" (so at most 4.6M), and
# the meter stood at 85% when this session had spent 2.3M (so at least 2.7M, if nothing else
# ran in the window). The middle is used; treat the percentage as good to about a third.
# Correct it when a better reading exists.
LIMIT_UNITS = 3_500_000
# A turn at or above this share of the window is a large one (the user's threshold).
LARGE_SHARE = 0.15


def find_transcript(arg):
    """The transcript path for a session id, or the argument itself if it is a file."""
    if arg and Path(arg).is_file():
        return arg
    session = arg or os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    hits = glob(str(Path.home() / ".claude/projects/*" / f"{session}.jsonl")) if session else []
    if not hits:
        sys.exit(f"session-cost: no transcript for {session or '(no session id given)'}")
    return hits[0]


def typed_text(row):
    """What the user typed in this row, or None for tool results and injected rows."""
    if row.get("type") != "user" or row.get("isMeta") or row.get("isSidechain"):
        return None
    content = row.get("message", {}).get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list) and not any(b.get("type") == "tool_result" for b in content):
        return " ".join(b.get("text", "") for b in content if b.get("type") == "text")
    return None


def call_units(usage):
    """One call's tokens by kind, weighted. Older rows lack the cache_creation split."""
    split = usage.get("cache_creation") or {}
    w5m = split.get("ephemeral_5m_input_tokens") or 0
    w1h = split.get("ephemeral_1h_input_tokens") or 0
    if not split:
        w5m = usage.get("cache_creation_input_tokens") or 0
    raw = {"in": usage.get("input_tokens") or 0, "read": usage.get("cache_read_input_tokens") or 0,
           "w5m": w5m, "w1h": w1h, "out": usage.get("output_tokens") or 0}
    context = raw["in"] + raw["read"] + raw["w5m"] + raw["w1h"]
    return {k: v * WEIGHTS[k] for k, v in raw.items()}, context


def main():
    turns = []  # each: {"text", "calls", "units": {kind: n}, "peak"}
    seen = set()  # one assistant message is written once per content block, same usage each time
    with open(find_transcript(sys.argv[1] if len(sys.argv) > 1 else "")) as f:
        for line in f:
            try:
                row = json.loads(line)
            except ValueError:
                continue
            text = typed_text(row)
            if text is not None:
                turns.append({"text": text, "calls": 0, "units": dict.fromkeys(WEIGHTS, 0.0), "peak": 0})
                continue
            message = row.get("message") or {}
            if row.get("type") != "assistant" or not message.get("usage") or message.get("id") in seen:
                continue
            seen.add(message.get("id"))
            if not turns:
                continue
            units, context = call_units(message["usage"])
            turn = turns[-1]
            turn["calls"] += 1
            turn["peak"] = max(turn["peak"], context)
            for kind, n in units.items():
                turn["units"][kind] += n

    print(f"{'turn':>4} {'calls':>5} {'units':>8} {'read':>5} {'write':>5} {'out':>5} {'peak':>6} {'limit':>6}  prompt")
    total_units = total_calls = 0
    for i, turn in enumerate(turns, 1):
        u = turn["units"]
        units = sum(u.values())
        if not turn["calls"]:
            continue
        total_units += units
        total_calls += turn["calls"]
        share = units / LIMIT_UNITS
        pct = lambda n: f"{100 * n / units:4.0f}%" if units else "    -"
        print(f"{i:>4} {turn['calls']:>5} {units / 1000:>7.0f}k {pct(u['read'])} {pct(u['w5m'] + u['w1h'])} "
              f"{pct(u['out'])} {turn['peak'] / 1000:>5.0f}k {100 * share:>5.1f}%"
              f"{' !' if share >= LARGE_SHARE else '  '}{' '.join(turn['text'].split())[:50]}")
    print(f"total: {total_calls} calls, {total_units / 1000:.0f}k units, "
          f"about {100 * total_units / LIMIT_UNITS:.0f}% of a five-hour window "
          f"(window taken as {LIMIT_UNITS / 1e6:.1f}M units; '!' marks a turn over {LARGE_SHARE:.0%})")


if __name__ == "__main__":
    main()
