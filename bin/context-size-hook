#!/usr/bin/env python3
"""UserPromptSubmit hook: tell Claude when an automatic compaction is near, or overdue.

The model cannot see its own context size, and the PreCompact hook runs too late to prepare
anything: on 2026-11-10 a session compacted automatically twice without the smart-compact
skill loading. So this hook says when the compaction is coming, while there is still time to
write down what the summary must keep.

It does not ask for an early compaction. The first version did, at a fixed 150k, on the belief
that re-reading a large context was the main cost. Measured on 2026-11-11 it is not: a call
re-reads the context at a fortieth of the input price (a twentieth below the strongest model),
while a compaction writes what it keeps again at twice the price, 150k to 250k claws each time.
Compacting at 150k instead of at the automatic point cost about a sixth more per call.

Reads the size and the model from the last assistant message in the transcript (input + cache
read + cache creation tokens), and the window from the settings (compact_window below). Fires
once at each step in STEPS, and again after a compaction brings the size back under the first
step. Injects context only; never blocks, exits 0 on any error.

It also notes user corrections. The introspection skill files what a correction teaches, but
nothing loaded it: the user will not invoke skills by hand, and the skill ran twice in 33
sessions. When the prompt reads like a correction (CORRECTION below), one line asks Claude to
file the lesson with the task's closing upkeep, and a marker is left in CORRECTIONS for the
PreCompact hook, which reminds the summary once if the session compacts first. The match is
by phrase and will misfire; a false note costs about thirty tokens and Claude ignores it.
"""
import json
import os
import re
import sys
from pathlib import Path

STATE = Path.home() / ".local/state/configme/context-size"
# Sizes at which to speak up, as fractions of the auto-compact window. The first comes shortly
# before the compaction: with a 200k window three of them fired at 163k to 168k, about 0.82.
# The others can only be reached while compaction is held or switched off.
STEPS = [0.7, 1.25, 2.0]
# The window when no setting gives a number (unset, or "auto", whose value is not published).
DEFAULT_WINDOW = 200_000
SETTINGS = Path.home() / ".claude/settings.json"
# The last usage record sits near the end of the transcript; this much is plenty to find it.
TAIL_BYTES = 400_000
# One file per session that has an unfiled correction; compact-notes-hook reads and removes it.
CORRECTIONS = Path.home() / ".local/state/configme/corrections"
# Phrasing that marks the user correcting Claude, not asking for something new.
CORRECTION = re.compile(
    r"^\s*(no|nope|wrong)\b[,.! ]"
    r"|\bi (already )?(said|told you|asked)\b"
    r"|\b(that'?s|that is|this is) (wrong|not what|incorrect)"
    r"|\bnot what i\b"
    r"|\b(stop|quit) (doing|asking|adding|using)\b"
    r"|\b(do not|don'?t|never) (do that|ask|freely)\b"
    r"|\b(you|it) should(n'?t| not)? have\b"
    r"|\bwhy did you\b"
    r"|\b(i was|you were|you are|you're) (wrong|mistaken)\b"
    r"|\bavoid (asking|doing|using|adding)\b"
    # A complaint about cost counts: the user's meter is the only place it shows.
    r"|\b(token burn|too many (tokens|calls)|(usage|hour|weekly) limit)\b",
    re.IGNORECASE)


def correction_note(prompt, session):
    """The line to inject when `prompt` reads like a correction, else None. Leaves the marker."""
    if not CORRECTION.search(prompt or ""):
        return None
    try:
        CORRECTIONS.mkdir(parents=True, exist_ok=True)
        (CORRECTIONS / session).write_text("1")
    except OSError:
        pass
    return ("This message reads like a correction. If it is one, file what it teaches with this "
            "task's closing upkeep batch: load the introspection skill then, not now, and use "
            "its filing table. If it is not a correction, ignore this line.")


def compact_window(model):
    """The auto-compact window, in tokens, that applies to `model`.

    Claude Code's own order: the CLAUDE_CODE_AUTO_COMPACT_WINDOW variable, then
    modelSettings.<model>.autoCompactWindow, then the top-level autoCompactWindow. A model key
    also matches its dated spellings, so it is compared as a prefix. Only the user's settings
    file is read; a project file that sets a window is not seen.
    """
    try:
        settings = json.loads(SETTINGS.read_text())
    except (OSError, ValueError):
        settings = {}
    per_model = settings.get("modelSettings") or {}
    keys = [k for k in per_model if model.startswith(k) and isinstance(per_model[k], dict)]
    candidates = [
        os.environ.get("CLAUDE_CODE_AUTO_COMPACT_WINDOW"),
        (settings.get("env") or {}).get("CLAUDE_CODE_AUTO_COMPACT_WINDOW"),
        per_model[max(keys, key=len)].get("autoCompactWindow") if keys else None,
        settings.get("autoCompactWindow"),
    ]
    for value in candidates:
        try:
            if int(value) > 0:
                return int(value)
        except (TypeError, ValueError):
            continue
    return DEFAULT_WINDOW


def last_context_size(transcript):
    """(tokens, model id) of the most recent assistant call, or None if the tail holds none."""
    with open(transcript, "rb") as f:
        f.seek(0, 2)
        f.seek(max(0, f.tell() - TAIL_BYTES))
        lines = f.read().decode("utf-8", errors="replace").splitlines()
    for line in reversed(lines):
        if '"usage"' not in line:
            continue
        try:
            row = json.loads(line)
        except ValueError:
            continue  # the first line of the tail is usually cut mid-row
        if row.get("type") != "assistant":
            continue
        usage = row.get("message", {}).get("usage") or {}
        size = sum(usage.get(k) or 0 for k in (
            "input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
        if size:
            return size, row.get("message", {}).get("model") or ""
    return None


try:
    payload = json.load(sys.stdin)
    session = payload.get("session_id", "") or "unknown"
    notes = []
    if re.fullmatch(r"[A-Za-z0-9_-]{1,80}", session):  # it becomes a file name
        note = correction_note(payload.get("prompt"), session)
        if note:
            notes.append(note)
    try:
        last = last_context_size(payload["transcript_path"])
    except Exception:
        last = None
    if last is not None:
        size, model = last
        window = compact_window(model)
        reached = sum(1 for step in STEPS if size >= step * window)
        marker = STATE / session
        told = int(marker.read_text()) if marker.exists() else 0
        if reached != told:
            STATE.mkdir(parents=True, exist_ok=True)
            marker.write_text(str(reached))
        if reached > told and reached == 1:
            notes.append(
                f"This conversation is about {size // 1000}k tokens and the auto-compact window "
                f"is {window // 1000}k, so an automatic compaction is a few calls away. Do not "
                "ask the user to compact or clear early; it costs more than it saves. If "
                "something still needed exists only in this conversation (a decision, findings "
                "not yet written, the state of a half-done task), load the smart-compact skill "
                "and write its notes file now, or write the thing to its file. Otherwise carry "
                "on and say nothing about it.")
        elif reached > told:
            notes.append(
                f"This conversation is about {size // 1000}k tokens, past the {window // 1000}k "
                "auto-compact window, so compaction is held or switched off. Answer the user's "
                "message first. Then load the smart-compact skill if it isn't loaded and tell "
                "the user in one line: remove the hold, compact, or clear. Do not suggest a new "
                "session unless call-economy.md's arithmetic says it pays.")
    if notes:
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "UserPromptSubmit",
            "additionalContext": "\n".join(notes),
        }}))
except Exception:
    pass
sys.exit(0)
