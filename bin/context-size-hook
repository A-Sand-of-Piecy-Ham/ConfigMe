#!/usr/bin/env python3
"""UserPromptSubmit hook: when the conversation has grown large, tell Claude to raise it.

Every call re-reads the whole conversation, so a session at 170k pays nearly three times what
one at 60k pays per call. The smart-compact skill covers what to do, but its "context over
~150k" trigger never fired: the model cannot see its own context size, and on 2026-11-10 a
session compacted automatically twice without the skill loading. The PreCompact hook runs too
late to prepare anything.

Reads the size from the last assistant message in the transcript (input + cache read + cache
creation tokens). Fires once at each step in STEPS, and again after a compaction brings the
size back under the first step. Injects context only; never blocks, exits 0 on any error.
"""
import json
import sys
from pathlib import Path

STATE = Path.home() / ".local/state/configme/context-size"
# Sizes, in tokens, at which to speak up. The first matches smart-compact's own threshold.
STEPS = [150_000, 250_000, 400_000]
# The last usage record sits near the end of the transcript; this much is plenty to find it.
TAIL_BYTES = 400_000


def last_context_size(transcript):
    """Tokens the most recent assistant call read, or None if the tail holds no usage record."""
    with open(transcript, "rb") as f:
        f.seek(0, 2)
        f.seek(max(0, f.tell() - TAIL_BYTES))
        lines = f.read().decode("utf-8", errors="replace").splitlines()
    for line in reversed(lines):
        if '"usage"' not in line:
            continue
        try:
            row = json.loads(line)
        except ValueError:
            continue  # the first line of the tail is usually cut mid-row
        if row.get("type") != "assistant":
            continue
        usage = row.get("message", {}).get("usage") or {}
        size = sum(usage.get(k) or 0 for k in (
            "input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
        if size:
            return size
    return None


try:
    payload = json.load(sys.stdin)
    session = payload.get("session_id", "") or "unknown"
    size = last_context_size(payload["transcript_path"])
    if size is None:
        sys.exit(0)
    reached = sum(1 for step in STEPS if size >= step)
    marker = STATE / session
    told = int(marker.read_text()) if marker.exists() else 0
    if reached != told:
        STATE.mkdir(parents=True, exist_ok=True)
        marker.write_text(str(reached))
    if reached > told:
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "UserPromptSubmit",
            "additionalContext": (
                f"This conversation is now about {size // 1000}k tokens, and every call re-reads "
                "all of it. Answer the user's message first. Then, if the smart-compact skill "
                "isn't loaded yet, invoke it and tell the user in one line whether to compact, "
                "clear or carry on."
            ),
        }}))
except Exception:
    pass
sys.exit(0)
