#!/usr/bin/env python3
"""PreToolUse hook (context7 and TickTick tools): tell Claude to load the skill that goes with
the tool it is about to call.

Across 33 saved sessions, context7 was called 10 times and TickTick 5 times, and neither
doc-lookup nor todo-capture was ever loaded: the description alone did not fire once the model
had already decided to call the tool. The two skills that did load reliably were the two with a
hook (docs-audience, git-workflow).

Fires once per session for each skill, so a run of calls costs one reminder, not one per call.
Injects context only; never blocks, and exits 0 on any error so it can't disrupt a session.

This cannot catch the other miss, a task mentioned in passing with no tool call at all: there is
nothing to hook.
"""
import json
import sys
from pathlib import Path

STATE = Path.home() / ".local/state/configme/skill-hints"

# Substring of the tool name -> (skill, what the skill adds at this moment).
# TickTick appears under its connector id in the desktop app and by name in the terminal CLI.
SKILLS = [
    ("context7", "doc-lookup", "it has answers already cached and says where to save a hard-won one"),
    ("15fae7e2-", "todo-capture", "it says which list and fields to use"),
    ("TickTick", "todo-capture", "it says which list and fields to use"),
]

try:
    payload = json.load(sys.stdin)
    tool = payload.get("tool_name", "")
    session = payload.get("session_id", "") or "unknown"
    match = next(((skill, adds) for key, skill, adds in SKILLS if key in tool), None)
    if not match:
        sys.exit(0)
    skill, adds = match
    marker = STATE / f"{session}.{skill}"
    if marker.exists():
        sys.exit(0)
    STATE.mkdir(parents=True, exist_ok=True)
    marker.touch()
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "additionalContext": (
            f"If the {skill} skill isn't loaded in this session yet, invoke it before going on: "
            f"{adds}."
        ),
    }}))
except Exception:
    pass
sys.exit(0)
