#!/usr/bin/env python3
"""PreToolUse hook (Edit|Write): when the target is a project doc, tell Claude to load the
docs-audience skill before writing.

Doc edits made as a side effect of a code change ("keep the runbook in sync") never look like
"writing docs", so the skill's own trigger missed them and the docs drifted. Injects context only;
never blocks, and exits 0 on any error so it can't disrupt a session.
"""
import json
import re
import sys

DOC = re.compile(r"/(README|EDITING|AGENTS|CONTRIBUTING)\.md$|/docs/[^/]+\.md$")

try:
    path = json.load(sys.stdin).get("tool_input", {}).get("file_path", "")
except Exception:
    sys.exit(0)
if not path or not DOC.search(path):
    sys.exit(0)

print(json.dumps({"hookSpecificOutput": {
    "hookEventName": "PreToolUse",
    "additionalContext": (
        f"{path} is a project doc. If the docs-audience skill isn't loaded in this session yet, "
        "invoke it before this edit, and place each line at its reader's depth."
    ),
}}))
