# The Windows clone is checked out by Git for Windows, which would otherwise
# rewrite these to CRLF. Bash cannot execute a CRLF script (`\r` becomes part
# of the interpreter path and every command argument), so pin LF explicitly on
# everything a shell or Neovim reads.
* text=auto eol=lf

*.sh      text eol=lf
*.lua     text eol=lf
*.conf    text eol=lf
*.toml    text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
bashrc*   text eol=lf
bash_profile* text eol=lf
.tmux.conf    text eol=lf
config.ghostty text eol=lf
gitignore_global text eol=lf

# PowerShell is happiest with CRLF and Windows-only anyway.
*.ps1     text eol=crlf
